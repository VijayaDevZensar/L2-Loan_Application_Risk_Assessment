{
  "version": "schema_v1.0",
  "description": "FinTrust Bank synthetic loan application schema",
  "fields": {
    "application_id": {
      "type": "string",
      "required": true,
      "unique": true,
      "pattern": "^APP\\d+$"
    },
    "age": {
      "type": "integer",
      "required": true,
      "min": 18,
      "max": 100
    },
    "age_band": {
      "type": "string",
      "required": false,
      "allowed": [
        "18-29",
        "30-39",
        "40-49",
        "50-59",
        "60+"
      ]
    },
    "annual_income": {
      "type": "float",
      "required": true,
      "min": 0
    },
    "employment_years": {
      "type": "float",
      "required": true,
      "min": 0
    },
    "existing_debt": {
      "type": "float",
      "required": true,
      "min": 0
    },
    "credit_score": {
      "type": "integer",
      "required": true,
      "min": 300,
      "max": 850
    },
    "loan_amount": {
      "type": "float",
      "required": true,
      "min": 1
    },
    "loan_term_months": {
      "type": "integer",
      "required": true,
      "allowed": [
        12,
        24,
        36,
        48,
        60,
        84,
        120
      ]
    },
    "previous_defaults": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "region": {
      "type": "string",
      "required": true,
      "allowed": [
        "North",
        "South",
        "East",
        "West",
        "Central"
      ]
    },
    "employment_type": {
      "type": "string",
      "required": true,
      "allowed": [
        "Salaried",
        "Self-Employed",
        "Contract",
        "Retired"
      ]
    },
    "repayment_status": {
      "type": "string",
      "required": true,
      "allowed": [
        "Good",
        "Delayed",
        "Default"
      ]
    },
    "debt_to_income": {
      "type": "float",
      "required": false,
      "min": 0
    },
    "synthetic_target": {
      "type": "integer",
      "required": true,
      "allowed": [
        0,
        1
      ]
    }
  },
  "leakage_fields": [
    "approval_flag"
  ],
  "note": "synthetic_target is the training label only \u2014 not for production features"
}